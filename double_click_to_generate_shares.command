#!/bin/bash
# เปลี่ยนโฟลเดอร์ไปยังโฟลเดอร์ที่สคริปต์นี้ตั้งอยู่ (โฟลเดอร์เว็บไซต์)
cd "$(dirname "$0")"

clear
echo "======================================================"
echo "    CK SECONDHAND - โปรแกรมสร้างหน้าแชร์สินค้าพรีวิว (Facebook/Line)"
echo "======================================================"
echo "ตำแหน่งโปรเจกต์: $(pwd)"
echo ""
echo "กำลังเริ่มดาวน์โหลดข้อมูลและสร้างหน้าพรีวิวสำหรับใช้แชร์..."
echo "------------------------------------------------------"

# รันไฟล์ Node.js เพื่อประมวลผลสร้างหน้าแชร์
node generate_share_pages.js

echo "------------------------------------------------------"
echo "เรียบร้อย! หน้าแชร์ของคุณได้รับการอัปเดตแล้ว"
echo "กดปุ่มใดก็ได้บนคีย์บอร์ดเพื่อปิดหน้าต่างนี้..."
read -n 1 -s
